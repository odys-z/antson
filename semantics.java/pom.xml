<?xml version="1.0" encoding="UTF-8"?>
<!--
  semantics.java: the parent of all odys-z java projects (antson, semantic.transact,
  semantic.DA, semantic.jserv, anclient.jserv, doctree.jserv, html-service, ...).

  It manages build plugin versions, the JUnit version, and shares the publishing
  metadata; it does not manage other dependencies, as our modules depend on each
  other at different versions.

  Child pom:
    <parent>
      <groupId>io.github.odys-z</groupId>
      <artifactId>semantics.java</artifactId>
      <version>0.0.1</version>
      <relativePath/>   <!- - ../semantics.java for antson.java and anson.reflect - ->
    </parent>

  and plugins without <version>. A child may still override a version property, e.g.
    <surefire.version>2.22.1</surefire.version>

  Build / release this pom first:
    mvn install
    mvn deploy -Dgpg.passphrase=...   (Central; before any child released on it)
-->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd"
  child.project.url.inherit.append.path="false">
  <modelVersion>4.0.0</modelVersion>

  <groupId>io.github.odys-z</groupId>
  <artifactId>semantics.java</artifactId>
  <version>0.0.1</version>
  <packaging>pom</packaging>
  <name>semantics.java</name>

  <url>http://github.com/odys-z/antson</url>
  <description>Parent pom of the odys-z semantics java projects: build plugin versions and publishing metadata.</description>

  <licenses>
    <license>
    	<name>MIT License</name>
    	<url>http://www.opensource.org/licenses/mit-license.php</url>
    </license>
  </licenses>

  <developers>
    <developer>
      <name>Ody Zhou</name>
      <email>odys.zhou@gmail.com</email>
      <organization>odys-z.github.io</organization>
      <organizationUrl>https://odys-z.github.io</organizationUrl>
    </developer>
  </developers>

  <scm child.scm.connection.inherit.append.path="false"
       child.scm.developerConnection.inherit.append.path="false"
       child.scm.url.inherit.append.path="false">
  	<connection>scm:git:git://github.com/odys-z/antson.git</connection>
  	<developerConnection>scm:git:odys-z@github.com:odys-z/antson.git</developerConnection>
  	<url>https://github.com/odys-z/antson</url>
  	<tag>HEAD</tag>
  </scm>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
	<maven.compiler.source>17</maven.compiler.source>
	<maven.compiler.target>17</maven.compiler.target>

	<!-- the lifecycle plugins, replacing the defaults of whichever Maven runs the build -->
	<clean-plugin.version>3.2.0</clean-plugin.version>
	<resources-plugin.version>3.3.1</resources-plugin.version>
	<compiler-plugin.version>3.13.0</compiler-plugin.version>
	<surefire.version>3.5.4</surefire.version>
	<jar-plugin.version>3.5.0</jar-plugin.version>
	<install-plugin.version>3.1.2</install-plugin.version>
	<deploy-plugin.version>3.1.2</deploy-plugin.version>

	<!-- packaging and release -->
	<source-plugin.version>3.3.1</source-plugin.version>
	<javadoc-plugin.version>3.5.0</javadoc-plugin.version>
	<gpg-plugin.version>3.2.8</gpg-plugin.version>
	<central-publishing.version>0.8.0</central-publishing.version>
	<shade-plugin.version>3.6.0</shade-plugin.version>
	<assembly-plugin.version>3.7.1</assembly-plugin.version>
	<dependency-plugin.version>3.7.0</dependency-plugin.version>
	<plugin-tools.version>3.15.1</plugin-tools.version>

	<!-- test dependencies, managed by junit-bom -->
	<junit.version>6.1.0</junit.version>
  </properties>

  <!-- Only versions: a child still declares the dependencies it uses, e.g.
       junit-jupiter-engine (test scope) without <version>. -->
  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.junit</groupId>
        <artifactId>junit-bom</artifactId>
        <version>${junit.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <distributionManagement>
	<snapshotRepository>
		<id>central</id>
		<url>https://central.sonatype.com/repository/maven-snapshots/</url>
	</snapshotRepository>
  </distributionManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-clean-plugin</artifactId>
          <version>${clean-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-resources-plugin</artifactId>
          <version>${resources-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>${compiler-plugin.version}</version>
        </plugin>
        <plugin>
          <!-- JUnit 5 requires 2.22.0 or higher, otherwise the name convention filter fails -->
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>${surefire.version}</version>
          <configuration>
            <argLine>-Dfile.encoding=UTF-8</argLine>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-jar-plugin</artifactId>
          <version>${jar-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-install-plugin</artifactId>
          <version>${install-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-deploy-plugin</artifactId>
          <version>${deploy-plugin.version}</version>
        </plugin>

        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-source-plugin</artifactId>
          <version>${source-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-javadoc-plugin</artifactId>
          <version>${javadoc-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-gpg-plugin</artifactId>
          <version>${gpg-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.sonatype.central</groupId>
          <artifactId>central-publishing-maven-plugin</artifactId>
          <version>${central-publishing.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-shade-plugin</artifactId>
          <version>${shade-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-assembly-plugin</artifactId>
          <version>${assembly-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-dependency-plugin</artifactId>
          <version>${dependency-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-plugin-plugin</artifactId>
          <version>${plugin-tools.version}</version>
        </plugin>
      </plugins>
    </pluginManagement>

    <plugins>
      <!-- publishing this pom itself; not inherited, children keep their own -->
	  <plugin>
		<groupId>org.sonatype.central</groupId>
		<artifactId>central-publishing-maven-plugin</artifactId>
		<inherited>false</inherited>
		<extensions>true</extensions>
		<configuration>
		  <publishingServerId>central</publishingServerId>
		  <autoPublish>true</autoPublish>
		</configuration>
	  </plugin>

	  <plugin>
		<groupId>org.apache.maven.plugins</groupId>
		<artifactId>maven-gpg-plugin</artifactId>
		<inherited>false</inherited>
		<executions>
		  <execution>
			<id>semantics.java</id>
			<phase>verify</phase>
			<goals>
			  <goal>sign</goal>
			</goals>
			<configuration>
			  <gpgArguments>
				<arg>--pinentry-mode=loopback</arg>
				<arg>--passphrase=${gpg.passphrase}</arg>
			  </gpgArguments>
			</configuration>
		  </execution>
		</executions>
	  </plugin>
    </plugins>
  </build>
</project>
