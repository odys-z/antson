<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.odys-z</groupId>
    <artifactId>semantics.java</artifactId>
    <version>0.0.1</version>
    <relativePath>../semantics.java</relativePath>
  </parent>

  <groupId>io.github.odys-z</groupId>
  <artifactId>anson.reflect</artifactId>
  <version>0.0.1</version>
  <packaging>maven-plugin</packaging>
  <name>anson.reflect</name>

  <url>http://github.com/odys-z/antson</url>
  <description>List a module's types, fields and the types they use into anson-types.json, for generating Anson peers.</description>

  <properties>
	<maven.version>3.9.11</maven.version>
	<plugin-tools.version>3.15.1</plugin-tools.version>
	<antson.version>1.2.0</antson.version>
  </properties>

  <dependencies>
	<!-- the Mojo API, provided by Maven at run time -->
	<dependency>
	  <groupId>org.apache.maven</groupId>
	  <artifactId>maven-plugin-api</artifactId>
	  <version>${maven.version}</version>
	  <scope>provided</scope>
	</dependency>

	<!-- MavenProject, Artifact -->
	<dependency>
	  <groupId>org.apache.maven</groupId>
	  <artifactId>maven-core</artifactId>
	  <version>${maven.version}</version>
	  <scope>provided</scope>
	</dependency>

	<!-- @Mojo, @Parameter, read by maven-plugin-plugin at build time -->
	<dependency>
	  <groupId>org.apache.maven.plugin-tools</groupId>
	  <artifactId>maven-plugin-annotations</artifactId>
	  <version>${plugin-tools.version}</version>
	  <scope>provided</scope>
	</dependency>

	<!-- reads class files without loading them -->
	<dependency>
	  <groupId>org.ow2.asm</groupId>
	  <artifactId>asm</artifactId>
	  <version>9.8</version>
	</dependency>

	<!-- writes anson-types.json -->
	<dependency>
	  <groupId>io.github.odys-z</groupId>
	  <artifactId>antson</artifactId>
	  <version>${antson.version}</version>
	</dependency>

	<!-- antson's test types, which the test types in io.oz.anson.reflect.ttypes depend on -->
	<dependency>
	  <groupId>io.github.odys-z</groupId>
	  <artifactId>antson</artifactId>
	  <version>${antson.version}</version>
	  <type>test-jar</type>
	  <scope>test</scope>
	</dependency>

	<dependency>
	  <groupId>org.junit.jupiter</groupId>
	  <artifactId>junit-jupiter-engine</artifactId>
	  <scope>test</scope>
	</dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- generates META-INF/maven/plugin.xml from the annotations; mvn anson:types -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-plugin-plugin</artifactId>
        <configuration>
          <goalPrefix>anson</goalPrefix>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
